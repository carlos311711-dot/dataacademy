# Copia este archivo a .env y pon tu API key de Gemini (nunca la subas a git).
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional: modelos en orden de preferencia, separados por coma (si uno está saturado, usa el siguiente)
GEMINI_MODEL=gemini-flash-lite-latest,gemini-3.5-flash-lite,gemini-flash-latest
