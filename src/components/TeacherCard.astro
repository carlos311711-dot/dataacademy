---
import { courses, type Teacher } from "../data/academy";
interface Props { teacher: Teacher; index?: number; full?: boolean }
const { teacher: t, index = 0, full = false } = Astro.props;
const taught = courses.filter((c) => t.courses.includes(c.id));
---
<article class="teacher rv" style={`--d:${(index * 0.07).toFixed(2)}s`} data-tool={t.tool}>
  <!-- ponytail: fotos son flyers completos; recorte por CSS. Reemplazar por retratos limpios cuando existan -->
  <div class="avatar" style={`--z:${t.zoom ?? 2.6};--f:${t.focus ?? "79% 12%"}`}><span><img src={t.photo} alt={t.name} loading="lazy" /></span></div>
  <h3>{t.name}</h3>
  <p class="role">{t.role}</p>
  {full && <p class="bio">{t.bio}</p>}
  <div class="sep"></div>
  <div class="orgs">
    <span class="org">{t.company}</span>
    {full ? taught.map((c) => <a class="org course-link" href={c.href}>{c.short}</a>) : <span class="org tool">{t.tool}</span>}
  </div>
</article>

<style>
  .teacher { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 22px 18px 18px; border-radius: 20px; border: 1px solid var(--border-color); background: #fff; color: var(--text-main); transition: transform .35s var(--ease), box-shadow .35s var(--ease), opacity .8s var(--ease) var(--d, 0s), translate .8s var(--ease) var(--d, 0s); }
  .teacher:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgba(6, 14, 42, .3); }
  .teacher[hidden] { display: none; }
  .avatar { width: 96px; height: 96px; border-radius: 50%; padding: 3px; background: linear-gradient(135deg, var(--accent-color), #1E52C0); }
  .avatar span { display: block; width: 100%; height: 100%; border-radius: 50%; border: 3px solid #fff; overflow: hidden; background: #dfe6ee; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; transform: scale(var(--z)); transform-origin: var(--f); transition: transform .5s var(--ease); }
  .teacher:hover .avatar img { transform: scale(calc(var(--z) * 1.06)); }
  h3 { margin: 14px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 17px; }
  .role { margin: 4px 0 0; font-size: 13px; color: var(--text-muted); }
  .bio { margin: 10px 0 0; font-size: 13.5px; line-height: 1.55; color: var(--text-muted); }
  .sep { width: 100%; height: 1px; margin: 16px 0 12px; background: var(--border-color); }
  .orgs { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .org { padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border-color); font-size: 12px; font-weight: 700; color: var(--text-main); }
  .tool { color: var(--accent-color); }
  .course-link:hover { border-color: var(--accent-color); color: var(--accent-color); }
</style>
