---
import { courses, type Teacher } from "../data/academy";
interface Props { teacher: Teacher; index?: number; full?: boolean }
const { teacher: t, index = 0, full = false } = Astro.props;
const taught = courses.filter((c) => t.courses.includes(c.id));
---
<article class="teacher rv" style={`--d:${(index * 0.07).toFixed(2)}s`} data-tool={t.tool}>
  <div class="avatar"><span><img src={t.photo} alt={t.name} loading="lazy" /></span></div>
  <h3>{t.name}</h3>
  <p class="role">{t.role}</p>
  <div class="company-badge" title={t.company}>
    <img src={t.companyLogo} alt={t.company} loading="lazy" />
  </div>
  {full && <p class="bio">{t.bio}</p>}
  <div class="sep"></div>
  <div class="orgs">
    <span class="org">{t.company}</span>
    {full
      ? taught.map((c) => <a class="org course-link" href={c.href}><img src={c.logo} alt="" />{c.short}</a>)
      : <span class="org tool">{t.toolLogos.map((l) => <img src={l} alt="" />)}{t.tool}</span>}
  </div>
</article>

<style>
  .teacher { display: flex; flex-direction: column; align-items: center; text-align: center; padding: 24px 18px 18px; border-radius: 20px; border: 1px solid var(--border-color); background: #fff; color: var(--text-main); transition: transform .35s var(--ease), box-shadow .35s var(--ease), opacity .8s var(--ease) var(--d, 0s), translate .8s var(--ease) var(--d, 0s); }
  .teacher:hover { transform: translateY(-6px); box-shadow: 0 30px 60px -30px rgba(6, 14, 42, .3); }
  .teacher[hidden] { display: none; }
  .avatar { width: 104px; height: 104px; border-radius: 50%; padding: 3px; background: linear-gradient(135deg, var(--accent-color), #1E52C0); box-shadow: 0 12px 24px -10px rgba(6, 14, 42, .25); }
  .avatar span { display: block; width: 100%; height: 100%; border-radius: 50%; border: 3px solid #fff; overflow: hidden; background: #fff; }
  .avatar img { width: 100%; height: 100%; object-fit: cover; object-position: center top; transition: transform .5s var(--ease); }
  .teacher:hover .avatar img { transform: scale(1.06); }
  h3 { margin: 14px 0 0; font-family: var(--font-display); font-weight: 800; font-size: 17px; }
  .role { margin: 4px 0 0; font-size: 13px; color: var(--text-muted); }
  .company-badge { margin-top: 10px; height: 34px; padding: 4px 12px; border-radius: 10px; border: 1px solid var(--border-color); background: #fff; display: inline-flex; align-items: center; justify-content: center; box-shadow: 0 2px 6px rgba(6, 14, 42, .05); }
  .company-badge img { max-height: 24px; max-width: 120px; width: auto; height: auto; object-fit: contain; border-radius: 4px; }
  .bio { margin: 12px 0 0; font-size: 13.5px; line-height: 1.55; color: var(--text-muted); }
  .sep { width: 100%; height: 1px; margin: 16px 0 12px; background: var(--border-color); }
  .orgs { margin-top: auto; display: flex; flex-wrap: wrap; justify-content: center; gap: 6px; }
  .org { display: inline-flex; align-items: center; gap: 5px; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border-color); font-size: 12px; font-weight: 700; color: var(--text-main); background: #fff; }
  .org img { width: 14px; height: 14px; object-fit: contain; }
  .tool { color: var(--accent-color); }
  .course-link:hover { border-color: var(--accent-color); color: var(--accent-color); }
</style>
