---
import { PRICE, WA, spec, specCourses, teachers, pad } from "../data/academy";
interface Props { timeline?: boolean }
const { timeline = false } = Astro.props;
const off = Math.round((1 - PRICE.spec / PRICE.specRegular) * 100);
---
<div class="spec-card rv">
  <div>
    <div class="badges">
      <span class="badge-live"><span class="live-dot"></span>Preventa abierta</span>
      <span class="badge-line">Programa insignia</span>
    </div>
    <h3>{spec.name}</h3>
    <p class="lead">{spec.lead}</p>
    <div class="facts">
      <div><span>Duración</span><b>{spec.hours}</b></div>
      <div><span>Cursos</span><b>4</b></div>
      <div><span>Proyectos</span><b>4 + 1</b></div>
      <div><span>Modalidad</span><b>En vivo</b></div>
    </div>
    <div class="price"><span class="small">Preventa · separa con S/ {PRICE.deposit}</span><div><b>S/ {PRICE.spec}</b> <s>S/ {PRICE.specRegular}</s> <em>−{off}%</em></div></div>
    <div class="da-row">
      <a href={spec.href} class="da-btn">Ver programa completo</a>
      <a href={WA} target="_blank" rel="noopener" class="da-btn da-btn-line">Quiero más información</a>
    </div>
  </div>
  {timeline ? (
    <ol class="steps">
      {specCourses.map((c, i) => <li style={`--d:${(0.2 + i * 0.1).toFixed(2)}s`}><b>{c.name}</b><span>Curso {pad(i + 1)} · {c.hours}{c.classes ? ` · ${c.classes} clases` : ""}</span></li>)}
      <li style="--d:.6s"><b>{spec.final.name}</b><span>{spec.final.time} · para tu portafolio</span></li>
      <li class="done" style="--d:.7s"><b>Certificado oficial</b><span>Data Academy · {spec.hours}</span></li>
    </ol>
  ) : (
    <div class="tiles">
      <div class="tile"><b>{spec.hours}</b><span>de formación en vivo</span></div>
      <div class="tile"><b>4 + 1</b><span>proyectos e integrador</span></div>
      <div class="tile hl"><b>S/ {PRICE.spec}</b><span>preventa · antes S/ {PRICE.specRegular}</span></div>
      <div class="tile"><b>Oficial</b><span>certificado Data Academy</span></div>
      <div class="tile wide"><span class="da-avatars">{teachers.map((t) => <img src={t.photo} alt="" />)}</span><span>Docentes de {teachers.map((t) => t.company).join(", ")}</span></div>
    </div>
  )}
</div>

<style>
  .spec-card { position: relative; overflow: hidden; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 40px; padding: clamp(28px, 4vw, 44px); border-radius: 28px; color: #fff; background: radial-gradient(600px 400px at 100% 0%, rgba(30, 82, 192, .55), transparent 60%), linear-gradient(135deg, #0F1E52, var(--navy)); box-shadow: 0 40px 80px -40px rgba(6, 14, 42, .6); }
  .spec-card::before { content: ""; position: absolute; left: 0; right: 0; top: 0; height: 2px; background: linear-gradient(90deg, var(--accent-color), transparent); }
  .badges { display: flex; flex-wrap: wrap; gap: 8px; }
  .badge-live, .badge-line { display: inline-flex; align-items: center; gap: 8px; padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .badge-live { background: #5DD8E8; color: var(--navy); }
  .badge-live .live-dot { background: var(--navy); }
  .badge-line { border: 1px solid rgba(255, 255, 255, .25); }
  h3 { margin: 18px 0 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(1.9rem, 3.6vw, 2.6rem); letter-spacing: -.025em; line-height: 1.08; color: #fff; }
  .lead { margin: 12px 0 0; max-width: 470px; font-size: 16px; line-height: 1.6; color: rgba(255, 255, 255, .72); }
  .facts { margin-top: 22px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .facts div { padding: 10px 12px; border-radius: 12px; border: 1px solid rgba(255, 255, 255, .12); background: rgba(255, 255, 255, .04); }
  .facts span { display: block; font-size: 11px; color: rgba(255, 255, 255, .55); }
  .facts b { font-family: var(--font-display); font-weight: 800; font-size: 18px; }
  .price { margin-top: 20px; }
  .price .small { font-size: 12px; color: rgba(255, 255, 255, .6); }
  .price b { font-family: var(--font-display); font-weight: 800; font-size: 32px; }
  .price s { color: rgba(255, 255, 255, .5); font-size: 14px; }
  .price em { margin-left: 6px; padding: 2px 8px; border-radius: 999px; background: #5DD8E8; color: var(--navy); font-style: normal; font-size: 12px; font-weight: 800; vertical-align: 6px; }
  .da-row { margin-top: 22px; }
  .steps { position: relative; list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; align-self: center; }
  .steps::before { content: ""; position: absolute; left: 21px; top: 20px; bottom: 20px; width: 2px; background: linear-gradient(var(--accent-color), #1E52C0); }
  .steps li { position: relative; padding: 12px 16px 12px 46px; border-radius: 14px; border: 1px solid rgba(255, 255, 255, .1); background: rgba(255, 255, 255, .05); transition: border-color .3s, background .3s; }
  .steps li:hover { border-color: rgba(93, 216, 232, .45); background: rgba(255, 255, 255, .08); }
  .steps li::before { content: ""; position: absolute; left: 14px; top: 50%; width: 14px; height: 14px; margin-top: -7px; border-radius: 50%; background: var(--accent-color); box-shadow: 0 0 0 4px rgba(0, 163, 200, .25); }
  .steps li.done::before { content: "✓"; display: grid; place-items: center; font-size: 10px; color: var(--navy); background: #5DD8E8; }
  .steps b { display: block; font-size: 15px; }
  .steps span { font-size: 12px; color: rgba(255, 255, 255, .6); }
  .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; align-content: center; }
  .tile { padding: 18px; border-radius: 16px; border: 1px solid rgba(255, 255, 255, .1); background: rgba(255, 255, 255, .04); transition: border-color .3s, background .3s; }
  .tile:hover { border-color: rgba(93, 216, 232, .45); background: rgba(255, 255, 255, .07); }
  .tile b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 28px; letter-spacing: -.02em; }
  .tile span { display: block; margin-top: 4px; font-size: 13px; color: rgba(255, 255, 255, .6); }
  .tile.hl { border-color: rgba(93, 216, 232, .4); background: rgba(93, 216, 232, .1); }
  .tile.hl b { color: #5DD8E8; }
  .tile.wide { grid-column: 1 / -1; display: flex; align-items: center; gap: 12px; padding: 12px 16px; }
  .tile.wide > span:last-child { margin: 0; font-size: 13px; font-weight: 600; color: rgba(255, 255, 255, .85); }
  .tile .da-avatars { display: flex; margin: 0; }
  .tile .da-avatars img { border-color: #0F1E52; }
  @media (max-width: 520px) { .facts { grid-template-columns: 1fr 1fr; } }
</style>
