                        );
                        return;
                    }

                    // 4. Verificar si eligió un curso específico de la lista
                    for (const [key, info] of Object.entries(COURSE_DETAILS)) {
                        const normKey = normalizeText(key);
                        if (
                            q === normKey ||
                            (q.includes("sql") && key.includes("SQL")) ||
                            (q.includes("power bi") &&
                                key.includes("Power BI")) ||
                            (q.includes("excel") && key.includes("Excel")) ||
                            (q.includes("python") && key.includes("Python")) ||
                            (q.includes("automate") &&
                                key.includes("Automate")) ||
                            (q.includes("workshop") && key.includes("Workshop"))
                        ) {
                            cursoInteres = info.title;
                            sendBotResponse(
                                info.desc,
                                [
                                    "💰 Ver precio de este curso",
                                    "📅 Ver horarios",
                                    "🔍 Tengo otra duda",
                                    "💬 Quiero hablar con un asesor humano",
                                ],
                                false,
                            );
                            return;
                        }
                    }

                    // 5. Respuesta a ¿Qué cursos tienen?
                    if (
                        q.includes("que cursos") ||
                        q.includes("cursos") ||
                        q.includes("temario") ||
                        q.includes("ensenan") ||
                        q.includes("aprender") ||
                        q.includes("herramientas")
                    ) {
                        sendBotResponse(
                            "Contamos con programas 100% prácticos con enfoque laboral en vivo:\n• <strong>SQL for Data Analyst</strong> (+30h)\n• <strong>Power BI for Data Analyst</strong> (+30h)\n• <strong>Excel for Data Analyst</strong> (+30h)\n• <strong>Python for Data Analyst</strong> (+30h)\n• <strong>Power Automate</strong> (15h intensivo)\n• <strong>Workshop Data Analyst &amp; IA</strong>\n\n¿Cuál de estos cursos te interesa más para contarte qué proyectos desarrollarás?",
                            [
                                "SQL for Data Analyst",
                                "Power BI for Data Analyst",
                                "Excel for Data Analyst",
                                "Python for Data Analyst",
                                "Power Automate",
                                "Workshop Data Analyst & IA",
                            ],
                            false,
                        );
                        return;
                    }

