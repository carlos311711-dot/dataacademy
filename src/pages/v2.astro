                            false,
                        );
                        return;
                    }

                    // 3. Si el usuario hace clic en "📚 Ver temario / Horarios"
                    if (q.includes("ver temario / horarios")) {
                        sendBotResponse(
                            "Puedes explorar el detalle de cada curso o conocer nuestros bloques de horarios flexibles. ¿Qué prefieres revisar primero?",
                            [
                                "📚 ¿Qué cursos tienen?",
                                "📅 Fechas de inicio y Duración",
                                "💰 Precios y Promociones",
                                "💬 Quiero hablar con un asesor humano",
                            ],
