        <script is:inline>
            (function () {
                const WA_PHONE = "51986575257";
                let botInitialized = false;
                let isBotTyping = false;
                let cursoInteres = "Especialización Data Analyst";
                let teaserDismissed = false;

                const MAIN_OPTIONS = [
                    "📚 ¿Qué cursos tienen?",
                    "💰 Precios y Promociones",
                    "📅 Fechas de inicio y Duración",
                    "🎓 ¿Entregan Certificado?",
                    "💻 Modalidad y Requisitos",
                ];

                const FOLLOWUP_OPTIONS = [
                    "🔍 Tengo otra duda",
                    "📚 Ver temario / Horarios",
                    "💬 Quiero hablar con un asesor humano",
                ];

                const COURSE_DETAILS = {
                    "SQL for Data Analyst": {
                        title: "SQL for Data Analyst",
                        desc: "📊 <strong>SQL for Data Analyst (+30h en vivo):</strong> Dominarás consultas en SQL Server, Transact-SQL, JOINs avanzados, subconsultas, CTEs, funciones de ventana y resolverás pruebas técnicas reales de procesos de selección.\n\n¿Te quedó clara esta parte o te gustaría revisar el precio de preventa y los horarios de este curso?",
                    },
                    "Power BI for Data Analyst": {
                        title: "Power BI for Data Analyst",
                        desc: "📈 <strong>Power BI for Data Analyst (+30h en vivo):</strong> Aprenderás limpieza ETL con Power Query, modelamiento dimensional en Estrella, DAX desde cero hasta avanzado y diseño de dashboards ejecutivos con storytelling.\n\n¿Te quedó clara esta parte o te gustaría revisar el precio de preventa y los horarios de este curso?",
                    },
                    "Excel for Data Analyst": {
                        title: "Excel for Data Analyst",
                        desc: "📗 <strong>Excel for Data Analyst (+30h en vivo):</strong> Dominarás funciones avanzadas (BUSCARX, FILTRAR), Power Query para automatizar reportes, Tablas Dinámicas y construcción de dashboards interactivos.\n\n¿Te quedó clara esta parte o te gustaría revisar el precio de preventa y los horarios de este curso?",
                    },
                    "Python for Data Analyst": {
                        title: "Python for Data Analyst",
                        desc: "🐍 <strong>Python for Data Analyst (+30h en vivo):</strong> Aprenderás automatización y análisis de datos con Pandas, visualización con Matplotlib & Seaborn, introducción a PySpark y control de versiones con Git/GitHub.\n\n¿Te quedó clara esta parte o te gustaría revisar el precio de preventa y los horarios de este curso?",
                    },
                    "Power Automate": {
                        title: "Power Automate for Data Analyst",
                        desc: "⚡ <strong>Power Automate (15h intensivo):</strong> Automatiza el envío de reportes por correo, consolida archivos de Excel automáticamente y conecta alertas inteligentes sin escribir código complejo.\n\n¿Te quedó clara esta parte o te gustaría revisar el precio de preventa y los horarios de este curso?",
                    },
                    "Workshop Data Analyst & IA": {
                        title: "Workshop: Tu Primer Proyecto DA",
                        desc: "🚀 <strong>Workshop Data Analyst & IA (15h intensivo):</strong> Construye un proyecto integral end-to-end combinando Python, arquitectura Medallón en Databricks, Power BI, Power Automate y herramientas de IA.\n\n¿Te quedó clara esta parte o te gustaría revisar el precio de preventa y los horarios de este curso?",
                    },
                };

                // Mostrar burbuja teaser a los 3 segundos
                setTimeout(() => {
                    const win = document.getElementById("databot-window");
                    const teaser = document.getElementById("databot-teaser");
                    if (
                        teaser &&
                        !teaserDismissed &&
                        (!win || !win.classList.contains("is-open"))
                    ) {
                        teaser.classList.add("is-visible");
                    }
                }, 3000);

                window.closeDataBotTeaser = (e) => {
                    if (e) e.stopPropagation();
                    teaserDismissed = true;
                    const teaser = document.getElementById("databot-teaser");
                    if (teaser) teaser.classList.remove("is-visible");
                };

                window.openDataBot = () => {
                    window.toggleDataBot(true);
                };

                window.toggleDataBot = (forceState) => {
                    const win = document.getElementById("databot-window");
                    const teaser = document.getElementById("databot-teaser");
                    if (!win) return;

                    const shouldOpen =
                        typeof forceState === "boolean"
                            ? forceState
                            : !win.classList.contains("is-open");

                    if (shouldOpen) {
                        win.classList.add("is-open");
                        if (teaser) teaser.classList.remove("is-visible");
                        teaserDismissed = true;

                        if (!botInitialized) {
                            botInitialized = true;
                            sendBotResponse(
                                "¡Hola! 👋 Soy el asistente virtual de <strong>Data Academy</strong>. Estoy aquí para resolver tus dudas en segundos sin que tengas que esperar.\n\n¿Qué te gustaría conocer hoy?",
                                MAIN_OPTIONS,
                                false,
                            );
                        } else {
                            setTimeout(() => {
                                const input =
                                    document.getElementById("databot-input");
                                if (input && !input.disabled) input.focus();
                            }, 120);
                        }
                    } else {
                        win.classList.remove("is-open");
                    }
                };

                function normalizeText(str) {
                    return String(str || "")
                        .toLowerCase()
                        .normalize("NFD")
                        .replace(/[\u0300-\u036f]/g, "")
                        .trim();
                }

                function scrollToBottom() {
                    const container =
                        document.getElementById("databot-messages");
                    if (container) {
                        container.scrollTop = container.scrollHeight;
                    }
                }

                function setControlsDisabled(disabled) {
                    isBotTyping = disabled;
                    const input = document.getElementById("databot-input");
                    const sendBtn = document.querySelector(".databot-send");
                    if (input) input.disabled = disabled;
                    if (sendBtn) sendBtn.disabled = disabled;
                    if (!disabled && input) {
                        input.focus();
                    }
                }

                function appendUserBubble(text) {
                    const container =
                        document.getElementById("databot-messages");
                    if (!container) return;
                    const div = document.createElement("div");
                    div.className = "databot-msg databot-msg--user";
                    div.textContent = text;
                    container.appendChild(div);
                    scrollToBottom();
                }

                function buildWhatsAppUrl() {
                    const curso = cursoInteres || "Especialización Data Analyst";
                    const msg = `Hola Data Academy, ya revisé la información de precios y horarios en el asistente web. Estoy interesado en inscribirme al curso de ${curso} y tengo una consulta final.`;
                    return `https://wa.me/${WA_PHONE}?text=${encodeURIComponent(msg)}`;
                }

                window.openLeadFromBot = () => {
                    window.toggleDataBot(false);
                    if (typeof window.openLeadModal === "function") {
                        window.openLeadModal(cursoInteres);
                    }
                };

                // Rutina de tipeo letra por letra (Typewriter Effect)
                function typeBotMessage(container, fullText, callback) {
                    const messageDiv = document.createElement("div");
                    messageDiv.className =
                        "databot-msg databot-msg--bot bot-message-bubble";
                    container.appendChild(messageDiv);

                    let index = 0;
                    const speed = 18; // milisegundos por caracter

                    function typeChar() {
                        if (index < fullText.length) {
                            // Si encuentra una etiqueta HTML, avanza hasta el cierre '>' para no mostrar código roto
                            if (fullText[index] === "<") {
                                const closeIdx = fullText.indexOf(">", index);
                                if (closeIdx !== -1) {
                                    index = closeIdx + 1;
                                } else {
                                    index++;
                                }
                            } else {
                                index++;
                            }
                            messageDiv.innerHTML = fullText
                                .slice(0, index)
                                .replace(/\n/g, "<br>");
                            container.scrollTop = container.scrollHeight;
                            setTimeout(typeChar, speed);
                        } else {
                            if (callback) callback(messageDiv);
                        }
                    }
                    typeChar();
                }

                function sendBotResponse(
                    fullText,
                    quickReplies = [],
                    showAdvisorHandoffButtons = false,
                ) {
                    const container =
                        document.getElementById("databot-messages");
                    if (!container) return;

                    // Bloquear temporalmente el input y remover botones previos mientras el bot piensa y escribe
                    setControlsDisabled(true);
                    container
                        .querySelectorAll(".databot-replies")
                        .forEach((el) => el.remove());

                    // 1. Mostrar burbuja animada de 3 puntitos ("DataBot está escribiendo...") durante 550ms
                    const typing = document.createElement("div");
                    typing.className = "databot-typing";
                    typing.innerHTML = `
                        <span>DataBot está escribiendo</span>
                        <span class="databot-typing__dots"><span></span><span></span><span></span></span>
                    `;
                    container.appendChild(typing);
                    scrollToBottom();

                    setTimeout(() => {
                        typing.remove();

                        // 2. Escribir el mensaje letra por letra
                        typeBotMessage(container, fullText, (messageDiv) => {
                            // 3. Si es el paso explícito de derivación a asesor, mostrar los dos botones finales
                            if (showAdvisorHandoffButtons) {
                                const actionsDiv =
                                    document.createElement("div");
                                actionsDiv.className = "databot-actions";
                                actionsDiv.innerHTML = `
                                    <button type="button" class="databot-cta-lead" onclick="openLeadFromBot()">
                                        📝 Dejar mis datos (Me contactan)
                                    </button>
                                    <a href="${buildWhatsAppUrl()}" target="_blank" rel="noopener" class="databot-cta-wa">
                                        📲 Abrir WhatsApp yo mismo
                                    </a>
                                `;
                                messageDiv.appendChild(actionsDiv);
                            }

                            // 4. Mostrar recién las opciones rápidas (Quick Replies) con fade-in
                            if (quickReplies && quickReplies.length > 0) {
                                const repliesDiv =
                                    document.createElement("div");
                                repliesDiv.className = "databot-replies";
                                quickReplies.forEach((label) => {
                                    const btn =
                                        document.createElement("button");
                                    btn.type = "button";
                                    btn.className = "databot-chip";
                                    btn.textContent = label;
                                    btn.onclick = () => {
                                        if (!isBotTyping) {
                                            window.handleDataBotInput(label);
                                        }
                                    };
                                    repliesDiv.appendChild(btn);
                                });
                                container.appendChild(repliesDiv);
                            }

                            setControlsDisabled(false);
                            scrollToBottom();
                        });
                    }, 550);
                }

                window.handleDataBotSubmit = (e) => {
                    e.preventDefault();
                    if (isBotTyping) return;
                    const input = document.getElementById("databot-input");
                    if (!input) return;
                    const text = input.value.trim();
                    if (!text) return;
                    input.value = "";
                    window.handleDataBotInput(text);
                };

                window.handleDataBotInput = (rawText) => {
                    if (isBotTyping) return;
                    appendUserBubble(rawText);
                    const q = normalizeText(rawText);

                    // 1. Flujo explícito para derivar a Asesor Humano / WhatsApp (SOLO bajo petición explícita)
                    if (
                        q.includes("asesor") ||
                        q.includes("humano") ||
                        q.includes("pasame a whatsapp") ||
                        q.includes("whatsapp") ||
                        q.includes("hablar con alguien") ||
                        q.includes("persona") ||
                        q.includes("inscribirme") ||
                        q.includes("matricularme") ||
                        q.includes("separar")
                    ) {
                        sendBotResponse(
                            "¡Por supuesto! Con gusto te comunico con un asesor de admisiones para que te atienda de forma personalizada. Antes de pasarte, ¿prefieres que te escribamos nosotros a tu WhatsApp dejando tus datos aquí o prefieres abrir el chat tú mismo ahora?",
                            ["🔍 Tengo otra duda"],
                            true,
                        );
                        return;
                    }

                    // 2. Si el usuario hace clic en "🔍 Tengo otra duda"
                    if (
                        q.includes("tengo otra duda") ||
                        q.includes("otra consulta") ||
                        q.includes("menu") ||
                        q.includes("opciones")
                    ) {
                        sendBotResponse(
                            "¡Claro que sí! 😊 Dime qué tema te gustaría revisar o selecciónalo aquí abajo:",
