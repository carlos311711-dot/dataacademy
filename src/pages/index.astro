---
import BaseLayout from "../layouts/BaseLayout.astro";
import SpecCard from "../components/SpecCard.astro";
import CourseCard from "../components/CourseCard.astro";
import TeacherCard from "../components/TeacherCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { WA, PRICE, spec, courses, teachers, stats, ecosystem, pad } from "../data/academy";

const tools = [
  ["Excel", "/img/formation/3Excel.png"],
  ["SQL Server", "/img/formation/2sqlserver.png"],
  ["Power BI", "/img/formation/4Powerbi.png"],
  ["Python", "/img/formation/5Python.png"],
  ["Power Automate", "/img/formation/8Autiamte.png"],
  ["Databricks", "/img/formation/databrick2.png"],
  ["Azure", "/img/formation/10AZURE.png"],
  ["Google Cloud", "/img/formation/9GCP.png"],
];

const sqlStats = [
  ["alumnos_formados", "+500", "93%"],
  ["proyectos_desarrollados", "+15", "95%"],
  ["filas_procesadas", "+50M", "90%"],
  ["satisfaccion", "4.9/5", "98%"],
];

const projects = [
  ["Dashboard básico Power BI", "Power BI", ["Power BI", "Power Query", "Excel"], "Dashboard introductorio para control y visualización de indicadores comerciales y de ventas.", "/img/projects/proyecto_powerbi_dashboard.png", "Power BI", "/cursos/powerbi"],
  ["Análisis de RR.HH. – Rotación y desempeño", "SQL", ["SQL Server", "CTEs", "KPIs"], "Análisis de rotación y desempeño de personal con consultas SQL, CTEs y KPIs de RR.HH.", "/img/projects/sql_project.webp", "SQL for Data Analyst", "/cursos/sql"],
  ["Automatización CRM + WhatsApp", "n8n", ["n8n", "HubSpot", "WhatsApp"], "Flujo n8n que conecta formularios web con HubSpot, WhatsApp y emails personalizados.", "/img/projects/proyecto_n8n_flow.webp", spec.name, spec.href],
  ["Arquitectura Medallón Lakehouse", "Integrales", ["Data Lake", "SQL Server", "ETL"], "Capas bronze, silver y gold para calidad y consistencia del pipeline de datos.", "/img/projects/proyecto_medallon.png", spec.name, spec.href],
  ["Proyecto Business Intelligence", "Power BI", ["Power BI", "DAX", "Modelo estrella"], "Tablero de control para análisis estratégico de ventas, control financiero y proyección de KPIs.", "/img/projects/proyecto_powerbi_bi.png", "Power BI", "/cursos/powerbi"],
  ["Dashboard gerencial", "Integrales", ["Power BI", "SQL Server", "Storytelling"], "Panel ejecutivo con storytelling avanzado y análisis de rendimiento integral.", "/img/projects/proyecto_powerbi_hero.png", spec.name, spec.href],
].map(([title, cat, tags, desc, img, course, href], i) => ({ id: `P-${pad(i + 1)}`, n: pad(i + 1), title, cat, tags: tags as string[], desc, img, course, href }));
const tabs = ["Todos", "Power BI", "SQL", "n8n", "Integrales"];
const SEL = 2;

const process = [
  ["Clase en vivo", "Aprendes con el docente en tiempo real."],
  ["Práctica guiada", "Resuelves ejercicios con datos reales."],
  ["Proyecto", "Construyes un entregable por curso."],
  ["Presentación", "Expones tu análisis como en una empresa."],
  ["Portafolio", "Sumas el proyecto a tu perfil."],
  ["Certificado", "Te certificas con Data Academy."],
];
const d = (i: number, step = 0.07) => `--d:${(i * step).toFixed(2)}s`;
---

<BaseLayout
  title="Data Academy | Power BI, SQL, Python y más"
  description="Formación en vivo para Data Analysts en Perú y Latam: proyectos reales, certificación oficial y una ruta de 150 horas con Excel, SQL Server, Power BI y Python."
>
  <!-- Hero -->
  <section class="hero-sec">
    <div class="da-wrap hero-grid">
      <div>
        <a href={spec.href} class="hero-badge rv"><span class="live-dot"></span>{spec.name} · preventa abierta <span aria-hidden="true">→</span></a>
        <div class="hero-eyebrow rv" style={d(1)}>Excel · SQL Server · Power BI · Python</div>
        <h1 class="hero-h1 type rv" style={d(2)} aria-label="Domina Excel, SQL, Power BI y Python.">
          <span class="ghost" aria-hidden="true">Domina<br /><span class="accent">Power BI.</span></span>
          <span class="typed" aria-hidden="true" data-words="Excel.|SQL.|Power BI.|Python."><span>Domina</span><br /><span class="accent">Excel.</span><span class="h1-cursor"></span></span>
        </h1>
        <p class="hero-p rv" style={d(3)}>Aprende las habilidades que más piden las empresas hoy, en clases en vivo y con proyectos reales.</p>
        <div class="da-row rv" style={d(4)}>
          <a href={WA} target="_blank" rel="noopener" class="da-btn">Hablar con Data Academy <span aria-hidden="true">→</span></a>
          <a href="/cursos" class="da-btn da-btn-line">Ver cursos</a>
        </div>
        <div class="explore rv" style={d(5)}>
          <span>Explora:</span>
          <a href={spec.href}>Data Analyst <em>Abierto</em></a>
          {courses.slice(0, 4).map((c) => <a href={c.href}>{c.short}</a>)}
        </div>
      </div>

      <div class="hero-visual rv" style={d(2)}>
        <div class="float-badge fb-top"><span class="fb-ico">✓</span><div><b>Certificado oficial</b><span>Data Academy · con proyecto</span></div></div>
        <div class="sqlcard">
          <div class="sql-bar">
            <div class="row-tight"><span class="d"></span><span class="d"></span><span class="d on"></span><b>resultados.sql</b></div>
            <span class="muted">5ta edición</span>
          </div>
          <pre class="sql"><span class="muted">-- lo que ya construimos juntos</span>
<b>SELECT</b> métrica, valor
<b>FROM</b> data_academy.alumnos;<span class="cursor"></span></pre>
          {sqlStats.map(([key, value, w], i) => (
            <div class="stat">
              <span class="num">{pad(i + 1)}</span>
              <div class="grow">
                <div class="key">{key}</div>
                <div class="bar"><div style={`width:${w};animation-delay:${0.6 + i * 0.12}s`}></div></div>
              </div>
              <span class="val">{value}</span>
            </div>
          ))}
          <div class="sql-foot"><span>4 filas · 0.02 s</span></div>
        </div>
        <div class="float-badge fb-bottom"><span class="da-avatars">{teachers.map((t) => <img src={t.photo} alt="" />)}</span><div><b>Docentes en ejercicio</b><span>{teachers.slice(0, 3).map((t) => t.company).join(" · ")}</span></div></div>
      </div>
    </div>
    <div class="da-wrap">
      <div class="hero-stats">
        {stats.map(([big, small], i) => <div class="rv" style={d(i)}><b>{big}</b><span>{small}</span></div>)}
      </div>
    </div>
  </section>

  <!-- Herramientas -->
  <section class="tools-band" aria-label="Herramientas que dominarás">
    <div class="tools-title">Herramientas que dominarás</div>
    <div class="marquee">
      <div class="marquee-track">
        {[...tools, ...tools].map(([name, logo], i) => (
          <span class="tool-item" aria-hidden={i >= tools.length ? "true" : undefined}><img src={logo} alt="" />{name}</span>
        ))}
      </div>
    </div>
  </section>

  <!-- Dos caminos -->
  <section class="paths da-wrap">
    <a href="/cursos" class="path rv">
      <span class="path-tag">Para empezar</span>
      <h3>Cursos individuales</h3>
      <p>Una herramienta a la vez: Excel, SQL, Power BI, Python o Power Automate. Desde S/ {PRICE.course} en preventa.</p>
      <span class="da-link">Ver cursos <span aria-hidden="true">→</span></span>
      <svg class="path-art" viewBox="0 0 80 80" aria-hidden="true"><circle cx="46" cy="40" r="32" fill="#E6F0FB" /><path d="M10 66 32 46l12 8 26-30" fill="none" stroke="#1E52C0" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" /><circle cx="70" cy="24" r="4" fill="#00A3C8" /></svg>
    </a>
    <a href={spec.href} class="path dark rv" style={d(1)}>
      <span class="path-tag">Ruta completa</span>
      <h3>{spec.name}</h3>
      <p>4 cursos + proyecto integrador. {spec.hours} en vivo por S/ {PRICE.spec} en preventa.</p>
      <span class="da-link">Ver la especialización <span aria-hidden="true">→</span></span>
      <svg class="path-art" viewBox="0 0 80 80" aria-hidden="true"><circle cx="46" cy="40" r="32" fill="rgba(255,255,255,.08)" /><rect x="22" y="44" width="9" height="22" rx="2" fill="#5DD8E8" opacity=".6" /><rect x="36" y="32" width="9" height="34" rx="2" fill="#5DD8E8" opacity=".8" /><rect x="50" y="18" width="9" height="48" rx="2" fill="#5DD8E8" /></svg>
    </a>
  </section>

  <!-- 01 Formación -->
  <section id="formacion" class="da-sec">
    <div class="da-wrap">
      <span class="da-kicker rv">01 · Formación especializada</span>
      <h2 class="da-h2 rv" style={d(1)}>Domina los datos. <span class="da-pill">Elige tu ruta.</span></h2>
      <p class="da-lead rv" style={d(2)}>Cursos 100% en vivo, con proyectos sobre datos reales de negocio.</p>
      <div class="mt"><SpecCard /></div>
      <div class="course-grid">
        {courses.slice(1, 4).map((c, i) => <CourseCard course={c} index={i} />)}
      </div>
      <div class="center rv"><a href="/cursos" class="da-link">Ver los {courses.length} cursos <span aria-hidden="true">→</span></a></div>
    </div>
  </section>

  <!-- 02 Portafolio -->
  <section id="portafolio" class="da-sec soft">
    <div class="da-wrap">
      <div class="da-head">
        <div>
          <span class="da-kicker rv">02 · Portafolio real</span>
          <h2 class="da-h2 rv" style={d(1)}>No solo aprendes. <span class="da-pill">Construyes.</span></h2>
          <p class="da-lead rv" style={d(2)}>Proyectos que muestras en tu próxima entrevista.</p>
        </div>
        <div class="tabs rv" style={d(2)} role="tablist">
          {tabs.map((t, i) => <button type="button" class:list={["tab", { on: i === 0 }]} data-tab={t}>{t}</button>)}
        </div>
      </div>
      <div class="port-grid">
        <div class="port-list rv">
          {projects.map((p, i) => (
            <button type="button" class:list={["proj", { on: i === SEL }]} data-id={p.id} data-cat={p.cat}>
              <span class="proj-n">{p.n}</span>
              <span class="grow"><b>{p.title}</b><span class="meta">{p.tags.join(" · ")}</span></span>
              <span class="arrow" aria-hidden="true">→</span>
            </button>
          ))}
        </div>
        <div class="port-detail rv" style={d(1)}>
          {projects.map((p, i) => (
            <article data-id={p.id} hidden={i !== SEL}>
              <div class="shot"><img src={p.img} alt={p.title} loading="lazy" /></div>
              <div class="detail-top"><b>{p.id}</b><span>{p.cat}</span></div>
              <h3>{p.title}</h3>
              <p>{p.desc}</p>
              <a href={p.href} class="da-link">Lo haces en {p.course} <span aria-hidden="true">→</span></a>
            </article>
          ))}
        </div>
      </div>

      <div class="process-head rv">
        <h3>De la clase a tu portafolio.</h3>
        <span>Así trabajamos en cada curso</span>
      </div>
      <ol class="process">
        {process.map(([t, s], i) => <li class:list={["rv", { last: i === process.length - 1 }]} style={d(i, 0.1)}><span class="pn">{pad(i + 1)}</span><b>{t}</b><span>{s}</span></li>)}
      </ol>

      <div class="eco rv">
        <div><h3>Las herramientas cambian.<br />El criterio permanece.</h3><span>Ecosistema que usarás</span></div>
        {ecosystem.map(([cat, items]) => <div><h4>{cat}</h4><div class="eco-chips">{items.map((x) => <span>{x}</span>)}</div></div>)}
      </div>
    </div>
  </section>

  <!-- 03 Docentes -->
  <section id="docentes" class="da-sec">
    <div class="da-wrap">
      <span class="da-kicker rv">03 · Nuestro equipo</span>
      <h2 class="da-h2 rv" style={d(1)}>Aprende de quienes <span class="da-pill">trabajan con datos.</span></h2>
      <p class="da-lead rv" style={d(2)}>Cada curso lo dictan profesionales en ejercicio en empresas peruanas.</p>
      <a href="/profesores" class="da-link rv" style={`margin-top:16px;${d(3)}`}>Conoce a todo el equipo <span aria-hidden="true">→</span></a>
      <div class="teach-grid">
        {teachers.map((t, i) => <TeacherCard teacher={t} index={i} />)}
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<script>
  // Titular con efecto de escritura (sin JS o con reduced-motion se ve completo)
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const typed = document.querySelector<HTMLElement>(".typed")!;
    const [head, tail] = typed.querySelectorAll<HTMLElement>("span:not(.h1-cursor)");
    const prefix = head.textContent ?? "";
    const words = typed.dataset.words!.split("|");
    head.textContent = tail.textContent = "";
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      await wait(500);
      for (let c = 1; c <= prefix.length; c++) { head.textContent = prefix.slice(0, c); await wait(55); }
      for (let w = 0; ; w = (w + 1) % words.length) {
        const word = words[w];
        for (let c = 1; c <= word.length; c++) { tail.textContent = word.slice(0, c); await wait(70); }
        await wait(1800);
        for (let c = word.length; c >= 0; c--) { tail.textContent = word.slice(0, c); await wait(90); }
        await wait(250);
      }
    })();
  }

  // Portafolio: pestañas + selección
  const projs = [...document.querySelectorAll<HTMLButtonElement>(".proj")];
  const details = [...document.querySelectorAll<HTMLElement>(".port-detail article")];
  const select = (id: string) => {
    projs.forEach((b) => b.classList.toggle("on", b.dataset.id === id));
    details.forEach((d) => (d.hidden = d.dataset.id !== id));
  };
  projs.forEach((b) => b.addEventListener("click", () => select(b.dataset.id!)));
  document.querySelectorAll<HTMLButtonElement>(".tab").forEach((t, _, all) =>
    t.addEventListener("click", () => {
      all.forEach((x) => x.classList.toggle("on", x === t));
      const vis = projs.filter((b) => (b.hidden = !(t.dataset.tab === "Todos" || b.dataset.cat === t.dataset.tab), !b.hidden));
      if (!vis.some((b) => b.classList.contains("on"))) select(vis[0].dataset.id!);
    }),
  );
</script>

<style>
  .grow { flex: 1; min-width: 0; }
  .row-tight { display: flex; align-items: center; gap: 8px; }
  .muted { color: var(--text-muted); }
  .mt { margin-top: 44px; }
  .center { margin-top: 28px; text-align: center; }

  /* Hero */
  .hero-sec { position: relative; overflow: hidden; color: #fff; background:
      radial-gradient(900px 620px at 85% 10%, rgba(30, 82, 192, .5), transparent 62%),
      radial-gradient(700px 520px at 60% 110%, rgba(0, 163, 200, .25), transparent 62%),
      var(--navy); }
  .hero-sec::before { content: ""; position: absolute; inset: 0; background-image: linear-gradient(rgba(255, 255, 255, .04) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .04) 1px, transparent 1px); background-size: 56px 56px; mask-image: radial-gradient(ellipse at 70% 30%, #000 20%, transparent 75%); pointer-events: none; }
  .hero-grid { position: relative; padding-top: 64px; padding-bottom: 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr)); gap: 56px; align-items: center; }
  .hero-badge { display: inline-flex; align-items: center; gap: 10px; padding: 6px 14px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .14); background: rgba(255, 255, 255, .05); font-size: 13px; font-weight: 600; color: #fff; }
  .hero-badge:hover { border-color: rgba(255, 255, 255, .35); color: #fff; }
  .hero-eyebrow { margin-top: 26px; font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: rgba(255, 255, 255, .55); }
  .hero-h1 { margin: 14px 0 0; font-family: var(--font-display); font-weight: 800; font-size: clamp(3rem, 6.2vw, 5rem); line-height: 1.02; letter-spacing: -.035em; color: #fff; }
  .type { display: grid; }
  .type > span { grid-area: 1 / 1; }
  .ghost { visibility: hidden; }
  .accent { color: #5DD8E8; }
  .h1-cursor { display: inline-block; width: .07em; height: .8em; margin-left: .06em; background: #5DD8E8; vertical-align: -.05em; animation: blink 1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .hero-p { margin: 22px 0 0; max-width: 480px; font-size: 17px; line-height: 1.6; color: rgba(255, 255, 255, .72); }
  .explore { margin-top: 26px; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; font-size: 12px; color: rgba(255, 255, 255, .55); }
  .explore a { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, .14); color: #fff; font-weight: 600; transition: border-color .25s, background .25s; }
  .explore a:hover { border-color: rgba(255, 255, 255, .4); background: rgba(255, 255, 255, .05); color: #fff; }
  .explore em { font-style: normal; font-size: 10px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; padding: 1px 6px; border-radius: 999px; background: #5DD8E8; color: var(--navy); }

  .hero-visual { position: relative; padding: 46px 0 22px; }
  .sqlcard { border-radius: 20px; background: #fff; color: var(--text-main); overflow: hidden; box-shadow: 0 40px 80px -30px rgba(0, 0, 0, .6); }
  .sql-bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 12px 18px; border-bottom: 1px solid var(--border-color); font-family: var(--font-mono); font-size: 12px; }
  .sql-bar b { margin-left: 8px; }
  .d { width: 10px; height: 10px; border-radius: 50%; background: var(--border-color); }
  .d.on { background: var(--accent-color); }
  .sql { margin: 0; padding: 18px; border-bottom: 1px solid var(--border-color); font-family: var(--font-mono); font-size: 13px; line-height: 24px; white-space: pre-wrap; background: var(--bg-light); }
  .sql b { color: var(--accent-color); }
  .cursor { display: inline-block; width: 8px; height: 16px; margin-left: 2px; transform: translateY(3px); background: var(--accent-color); animation: blink 1s steps(1) infinite; }
  .stat { display: flex; align-items: center; gap: 16px; padding: 14px 18px; border-bottom: 1px solid var(--border-color); }
  .sql-foot { display: flex; justify-content: flex-end; padding: 0 18px; height: 50px; align-items: center; background: var(--bg-light); font-family: var(--font-mono); font-size: 11px; color: var(--text-muted); }
  .num { font-family: var(--font-mono); font-size: 12px; color: var(--accent-color); }
  .key { font-family: var(--font-mono); font-size: 12px; }
  .bar { margin-top: 8px; height: 6px; border-radius: 999px; background: var(--bg-light); overflow: hidden; }
  .bar div { height: 100%; border-radius: 999px; background: linear-gradient(90deg, #1E52C0, var(--accent-color)); transform-origin: left; animation: grow 1.2s var(--ease) both; }
  .val { font-family: var(--font-display); font-weight: 800; font-size: 22px; letter-spacing: -.02em; }
  .float-badge { position: absolute; z-index: 2; display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 14px; background: #fff; color: var(--text-main); box-shadow: 0 18px 40px -16px rgba(0, 0, 0, .45); animation: flo 5s ease-in-out infinite; }
  .float-badge b { display: block; font-size: 13px; }
  .float-badge > div > span { display: block; font-size: 11px; color: var(--text-muted); }
  .fb-top { top: -4px; right: -12px; }
  .fb-bottom { bottom: 0; left: -16px; animation-delay: -2.5s; }
  .fb-ico { width: 30px; height: 30px; display: grid; place-items: center; border-radius: 8px; background: var(--navy); color: #5DD8E8; font-weight: 800; }
  .hero-stats { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); padding: 28px 0 40px; border-top: 1px solid rgba(255, 255, 255, .1); }
  .hero-stats div { padding: 0 24px; border-left: 1px solid rgba(255, 255, 255, .12); }
  .hero-stats div:first-child { padding-left: 0; border-left: 0; }
  .hero-stats b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 30px; letter-spacing: -.02em; }
  .hero-stats span { font-size: 13px; color: rgba(255, 255, 255, .6); }

  /* Marquee */
  .tools-band { padding: 28px 0 32px; border-bottom: 1px solid var(--border-color); text-align: center; }
  .tools-title { font-size: 11px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--text-muted); }
  .marquee { margin-top: 20px; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent); }
  .marquee-track { display: flex; gap: 56px; width: max-content; animation: mq 32s linear infinite; }
  .marquee:hover .marquee-track { animation-play-state: paused; }
  .tool-item { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; color: var(--text-muted); white-space: nowrap; }
  .tool-item img { width: 30px; height: 30px; object-fit: contain; }

  /* Dos caminos */
  .paths { margin-top: 72px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 20px; }
  .path { position: relative; overflow: hidden; padding: 30px 32px; border-radius: 22px; border: 1px solid var(--border-color); background: linear-gradient(135deg, #F7FAFE, #fff); color: var(--text-main); transition: transform .35s var(--ease), box-shadow .35s var(--ease), opacity .8s var(--ease) var(--d, 0s), translate .8s var(--ease) var(--d, 0s); }
  .path:hover { transform: translateY(-4px); box-shadow: 0 30px 60px -30px rgba(6, 14, 42, .3); color: var(--text-main); }
  .path.dark { border-color: transparent; color: #fff; background: radial-gradient(400px 300px at 100% 0%, rgba(30, 82, 192, .6), transparent 60%), linear-gradient(135deg, #0F1E52, var(--navy)); }
  .path.dark:hover { color: #fff; }
  .path-tag { display: inline-block; padding: 4px 10px; border-radius: 999px; border: 1px solid var(--border-color); font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--primary-color); background: #fff; }
  .path.dark .path-tag { border-color: rgba(93, 216, 232, .3); background: rgba(93, 216, 232, .1); color: #5DD8E8; }
  .path h3 { margin: 18px 0 0; max-width: 70%; font-family: var(--font-display); font-weight: 800; font-size: 26px; letter-spacing: -.02em; }
