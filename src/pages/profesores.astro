---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeacherCard from "../components/TeacherCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { teachers, companies, companyLogos, toolIconMap } from "../data/academy";

const tools = [...new Set(teachers.flatMap((t) => t.tool.split(" & ")))];
const count = (tool: string) => teachers.filter((t) => t.tool.includes(tool)).length;
---

<BaseLayout title="Equipo docente | Data Academy" description="Conoce a los docentes de Data Academy: profesionales de datos en ejercicio en RIMAC Seguros, Credicorp Capital, Interbank, Jockey Plaza, vooxell y bluetab (IBM).">
  <section class="da-hero-light">
    <div class="da-wrap">
      <div class="topline rv"><span class="da-kicker">Equipo docente</span><span>{teachers.length} docentes · {companies.length} empresas</span></div>
      <div class="pg-hero">
        <h1 class="da-h1 rv" style="--d:.07s">Docentes que <span class="da-pill">trabajan con datos</span> cada día.</h1>
        <div class="rv" style="--d:.14s">
          <p class="da-lead">Profesionales en ejercicio en <b>{companies.join(", ")}</b> que enseñan con los casos reales de su trabajo.</p>
          <span class="now">Trabajan hoy en</span>
          <div class="orgs">
            {companies.map((c) => (
              <span>
                {companyLogos[c] && <img src={companyLogos[c]} alt="" loading="lazy" />}
                {c}
              </span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="da-filterbar">
    <div class="da-wrap">
      <span class="lbl">Filtrar por herramienta</span>
      <div class="da-pills filter">
        <button type="button" class="on" data-tool="all">Todos <small>{teachers.length}</small></button>
        {tools.map((t) => <button type="button" data-tool={t}>{toolIconMap[t] && <img class="pill-ico" src={toolIconMap[t]} alt="" />}{t} <small>{count(t)}</small></button>)}
      </div>
      <span class="count"><b class="n">{teachers.length}</b> docentes</span>
    </div>
  </div>

  <section class="da-sec soft">
    <div class="da-wrap">
      <div class="grid">
        {teachers.map((t, i) => <TeacherCard teacher={t} index={i} full />)}
      </div>
    </div>
  </section>

  <CtaBand kicker="Aprende con este equipo" title="Aprende de quienes" accent="hacen el trabajo." text="Elige tu curso o la especialización completa y empieza a construir tu portafolio con ellos." />
</BaseLayout>

<script>
  const cards = [...document.querySelectorAll<HTMLElement>(".grid .teacher")];
  const n = document.querySelector(".count .n")!;
  document.querySelectorAll<HTMLButtonElement>(".filter button").forEach((b, _, all) =>
    b.addEventListener("click", () => {
      all.forEach((x) => x.classList.toggle("on", x === b));
      const t = b.dataset.tool!;
      let shown = 0;
      cards.forEach((c) => { c.hidden = !(t === "all" || c.dataset.tool!.includes(t)); if (!c.hidden) shown++; });
      n.textContent = String(shown);
    }),
  );
</script>

<style>
  .topline { padding-top: 36px; padding-bottom: 16px; display: flex; justify-content: space-between; align-items: center; gap: 12px; border-bottom: 1px solid var(--border-color); font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .pg-hero { padding: 48px 0 56px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr)); gap: 40px; align-items: center; }
  .pg-hero .da-lead b { color: var(--text-main); }
  .now { display: block; margin-top: 20px; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .orgs { margin-top: 10px; display: flex; flex-wrap: wrap; gap: 8px; }
  .orgs span { display: inline-flex; align-items: center; gap: 8px; padding: 6px 12px; border-radius: 999px; border: 1px solid var(--border-color); background: #fff; font-size: 13px; font-weight: 700; transition: border-color .25s, transform .25s var(--ease); }
  .orgs span img { height: 18px; width: auto; max-width: 68px; object-fit: contain; border-radius: 3px; }
  .orgs span:hover { border-color: var(--accent-color); transform: translateY(-2px); }
  .pill-ico { width: 15px; height: 15px; object-fit: contain; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 20px; }
</style>
