---
import BaseLayout from "../layouts/BaseLayout.astro";
import TeacherCard from "../components/TeacherCard.astro";
import CtaBand from "../components/CtaBand.astro";
import { WA, wa, PRICE, PREVENTA_FIN, spec, specCourses, teachers, companies, ecosystem, faq, pad } from "../data/academy";

const off = Math.round((1 - PRICE.spec / PRICE.specRegular) * 100);
const save = PRICE.courseRegular * 4 - PRICE.spec;
const steps = [
  ["Inicio", "En vivo · hora Perú"],
  ...specCourses.map((c) => [c.name.replace(" for Data Analyst", ""), `${c.classes} clases · ${c.hours}`]),
  [spec.final.name.replace(" final", ""), spec.final.time],
  ["Certificado", `${spec.hours} · oficial`],
];
---

<BaseLayout title={`${spec.name} | Data Academy`} description={`${spec.lead} Preventa S/ ${PRICE.spec}.`}>
  <!-- Hero -->
  <section class="da-hero-light">
    <div class="da-wrap pg-hero">
      <div>
        <span class="da-pillnote rv"><span class="live-dot"></span>Próxima edición · preventa abierta</span>
        <div class="da-kicker rv" style="--d:.07s;margin-top:22px">Programa insignia · Data Analyst</div>
        <h1 class="da-h1 rv" style="--d:.14s">Especialización en <span class="da-pill">Data Analyst</span></h1>
        <p class="da-lead rv" style="--d:.21s">Del Excel a Python, pasando por SQL Server y Power BI. En vivo, con docentes que trabajan en <b>{companies.slice(0, 3).join(", ")}</b> y más.</p>
        <div class="da-row rv" style="--d:.28s">
          <a href={wa(`Hola, quiero información de la ${spec.name}`)} target="_blank" rel="noopener" class="da-btn"><i class="fab fa-whatsapp"></i> Hablar por WhatsApp</a>
          <a href="#inversion" class="da-btn da-btn-ghost">Ver inversión y cupos →</a>
        </div>
        <div class="trust rv" style="--d:.35s"><span>★ 4.9/5 satisfacción</span><span>Empiezas desde cero</span><span>Separa con S/ {PRICE.deposit}</span></div>
      </div>

      <div class="offer rv" style="--d:.14s">
        <div class="offer-top">
          <div class="offer-row"><span>Preventa · cierra en</span><span class="tag-live">En vivo</span></div>
          <div class="cd" data-deadline={PREVENTA_FIN}>
            <div><b data-u="d">--</b><span>días</span></div><div><b data-u="h">--</b><span>hrs</span></div><div><b data-u="m">--</b><span>min</span></div><div><b data-u="s">--</b><span>seg</span></div>
          </div>
          <p>Clases en vivo por la noche · hora Perú</p>
        </div>
        <div class="offer-body">
          <div class="offer-row"><span>Ruta completa · 4 cursos + proyecto</span><em>−{off}%</em></div>
          <div class="big">S/ {PRICE.spec} <s>S/ {PRICE.specRegular}</s></div>
          <p>Preventa · ahorras S/ {save} frente al precio regular de los 4 cursos.</p>
          <a href={wa(`Hola, quiero separar mi cupo en la ${spec.name}`)} target="_blank" rel="noopener" class="da-btn wide">Separar mi cupo →</a>
          <span class="limited"><span class="live-dot"></span>Cupos limitados</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Sub-navegación -->
  <nav class="subnav" aria-label="Secciones del programa">
    <div class="da-wrap">
      <b>Data Analyst</b>
      <div class="links"><a href="#programa">El programa</a><a href="#modulos">Cursos</a><a href="#docentes">Docentes</a><a href="#inversion">Inversión</a><a href="#faq">FAQ</a></div>
      <span class="sub-price"><b>S/ {PRICE.spec}</b> · preventa · cupos limitados</span>
      <a href={WA} target="_blank" rel="noopener" class="sub-cta">Inscribirme</a>
    </div>
  </nav>

  <!-- La ruta -->
  <section id="programa" class="da-sec soft">
    <div class="da-wrap">
      <div class="route rv">
        <div class="route-head">
          <div>
            <span class="da-kicker">La ruta · 4 cursos</span>
            <h2 class="da-h2">Cuatro cursos, <span class="da-pill">un proyecto final.</span></h2>
          </div>
          <div class="route-stats"><div><b>{spec.hours}</b><span>en vivo</span></div><div><b>4</b><span>cursos</span></div><div><b>4 + 1</b><span>proyectos</span></div></div>
        </div>
        <ol class="track">
          {steps.map(([t, s], i) => <li class:list={["rv", { first: i === 0, end: i === steps.length - 1 }]} style={`--d:${(i * 0.12).toFixed(2)}s`}><span class="dot">{i === 0 ? "▶" : i === steps.length - 1 ? "✓" : pad(i)}</span><b>{t}</b><small>{s}</small></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="companies">
    <div class="da-wrap">
      <span>Nuestros docentes trabajan en</span>
      <div>{companies.map((c) => <b>{c}</b>)}</div>
    </div>
  </section>

  <!-- Adónde te lleva -->
  <section class="da-sec">
    <div class="da-wrap goals">
      <div>
        <span class="da-kicker rv">Adónde te lleva</span>
        <h2 class="da-h2 rv" style="--d:.07s">Terminas la ruta y <span class="da-pill">aplicas a estos puestos.</span></h2>
        <a href="#modulos" class="da-btn da-btn-ghost rv" style="--d:.14s;margin-top:24px">Ver el plan de estudios →</a>
      </div>
      <div class="roles rv" style="--d:.1s">
        <div class="roles-head"><span>Destino</span><span>Al terminar la ruta</span></div>
        {spec.roles.map((r, i) => <div class="role"><span>{pad(i + 1)}</span><b>{r}</b><i aria-hidden="true">→</i></div>)}
      </div>
    </div>
    <div class="da-wrap nums">
      <div class="rv"><b>+500</b><span>alumnos formados en Data Academy</span></div>
      <div class="rv" style="--d:.07s"><b>{teachers.length}</b><span>docentes que hoy trabajan con datos</span></div>
      <div class="rv" style="--d:.14s"><b>4.9<em>/5</em></b><span>de satisfacción de nuestros alumnos</span></div>
    </div>
  </section>

  <!-- Plan de estudios -->
  <section id="modulos" class="da-sec soft">
    <div class="da-wrap plan">
      <aside>
        <div class="sticky">
          <span class="da-kicker rv">Plan de estudios · 4 cursos</span>
          <h2 class="da-h2 rv" style="--d:.07s">Arma tu ruta, <span class="da-pill">curso a curso.</span></h2>
          <p class="da-lead rv" style="--d:.14s">Elige la especialización completa o solo los cursos que quieras, y envía tu selección por WhatsApp.</p>
          <div class="pick rv" style="--d:.21s">
            <span class="pick-k">Tu selección</span>
            <ul class="pick-list"><li class="muted">Aún no eliges cursos</li></ul>
            <div class="pick-total" hidden><span>Total preventa</span><b>S/ 0</b></div>
            <button type="button" class="pick-all">Elegir especialización completa</button>
            <a class="da-btn wide pick-send" href={WA} target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> Enviar selección por WhatsApp</a>
          </div>
        </div>
      </aside>
      <div class="mods">
        {specCourses.map((c, i) => {
          const t = teachers.find((x) => x.courses.includes(c.id));
          return (
            <article class="mod rv" data-name={c.name}>
              <div class="mod-head">
                <span class="mod-n">{pad(i + 1)}</span>
                <div class="grow">
                  <span class="mod-meta">Curso {pad(i + 1)} · {c.schedule}</span>
                  <h3>{c.name}</h3>
                  <span class="mod-sub">{c.classes} clases · {c.hours} en vivo{t && ` · ${t.name}`}</span>
                </div>
                <div class="mod-price"><s>S/ {PRICE.courseRegular}</s><b>S/ {PRICE.course}</b><span>preventa</span></div>
              </div>
              <ul class="checks">{c.syllabus.map((s) => <li>{s}</li>)}</ul>
              <p class="result"><b>Proyecto:</b> {c.project}.</p>
              <div class="mod-foot">
                <button type="button" class="add" aria-pressed="false">Agregar curso</button>
                <a href={c.href} class="da-link">Ver curso <span aria-hidden="true">→</span></a>
              </div>
            </article>
          );
        })}
        <article class="mod final rv">
          <div class="mod-head">
            <span class="mod-n">05</span>
            <div class="grow"><span class="mod-meta">Proyecto final · {spec.final.time}</span><h3>{spec.final.name}</h3><span class="mod-sub">{spec.final.desc}</span></div>
            <div class="mod-price"><b>Incluido</b><span>en la especialización</span></div>
          </div>
          <ul class="checks">{spec.final.syllabus.map((s) => <li>{s}</li>)}</ul>
        </article>
        <article class="mod bonus rv">
          <div class="mod-head">
            <span class="mod-n">+</span>
            <div class="grow"><span class="mod-meta">Bono</span><h3>{spec.bonus.name}</h3><span class="mod-sub">{spec.bonus.desc}</span></div>
            <div class="mod-price"><b>Gratis</b><span>incluido</span></div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- Herramientas -->
  <section class="da-sec">
    <div class="da-wrap">
      <span class="da-kicker rv">Ecosistema</span>
      <h2 class="da-h2 rv" style="--d:.07s">Las herramientas de los <span class="da-pill">equipos de datos.</span></h2>
      <div class="eco">
        {ecosystem.map(([cat, items], i) => <div class="rv" style={`--d:${(i * 0.07).toFixed(2)}s`}><h4>{cat}</h4><div class="chips">{items.map((x) => <span>{x}</span>)}</div></div>)}
      </div>
    </div>
  </section>

  <!-- Docentes -->
  <section id="docentes" class="da-sec soft">
    <div class="da-wrap">
      <span class="da-kicker rv">Docentes</span>
      <h2 class="da-h2 rv" style="--d:.07s">Aprende de quienes <span class="da-pill">trabajan con datos.</span></h2>
      <div class="teach">{teachers.map((t, i) => <TeacherCard teacher={t} index={i} full />)}</div>
    </div>
  </section>

  <!-- Certificado -->
  <section class="da-sec">
    <div class="da-wrap cert">
      <div>
        <span class="da-kicker rv">Certificación</span>
        <h2 class="da-h2 rv" style="--d:.07s">Certifícate con <span class="da-pill">tu proyecto.</span></h2>
        <ul class="checks big rv" style="--d:.14s">
          <li>Certificado oficial de Data Academy al completar la ruta</li>
          <li>Respaldado por tu proyecto integrador</li>
          <li>Listo para tu CV y tu perfil de LinkedIn</li>
        </ul>
      </div>
      <div class="cert-card rv" style="--d:.1s" aria-hidden="true">
        <span class="cert-k">Certificado</span>
        <b>{spec.name}</b>
        <span class="cert-line"></span><span class="cert-line short"></span>
        <div class="cert-foot"><span>{spec.hours} académicas</span><span class="seal">DA</span></div>
      </div>
    </div>
  </section>

  <!-- Inversión -->
  <section id="inversion" class="da-sec dark">
    <div class="da-wrap">
      <span class="da-kicker rv">Inversión</span>
      <h2 class="da-h2 rv" style="--d:.07s">Una inversión que se paga <span class="da-pill">con tu próximo rol.</span></h2>
      <div class="prices">
        <div class="price-card hl rv">
          <span class="p-badge">Recomendado · −{off}%</span>
          <h3>Especialización completa</h3>
          <div class="big">S/ {PRICE.spec} <s>S/ {PRICE.specRegular}</s></div>
          <ul class="checks">{spec.includes.map((x) => <li>{x}</li>)}</ul>
          <a href={wa(`Hola, quiero separar mi cupo en la ${spec.name}`)} target="_blank" rel="noopener" class="da-btn wide">Separar con S/ {PRICE.deposit} →</a>
        </div>
        <div class="price-card rv" style="--d:.1s">
          <span class="p-badge line">Flexible</span>
          <h3>Por curso</h3>
          <div class="big">S/ {PRICE.course} <s>S/ {PRICE.courseRegular}</s></div>
          <ul class="checks"><li>Un curso en vivo de tu elección</li><li>Proyecto del curso para tu portafolio</li><li>Certificado del curso</li><li>Sumas más cursos cuando quieras</li></ul>
          <a href="#modulos" class="da-btn da-btn-line wide">Elegir cursos</a>
        </div>
      </div>
      <p class="pnote rv">Separa tu cupo con S/ {PRICE.deposit} y cancela el saldo hasta una semana antes de iniciar. Precios de preventa para los primeros 10 cupos.</p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="da-sec">
    <div class="da-wrap faq">
      <div>
        <span class="da-kicker rv">Preguntas frecuentes</span>
        <h2 class="da-h2 rv" style="--d:.07s">Resolvemos <span class="da-pill">tus dudas.</span></h2>
        <a href={WA} target="_blank" rel="noopener" class="da-link rv" style="--d:.14s;margin-top:18px">¿Otra pregunta? Escríbenos <span aria-hidden="true">→</span></a>
      </div>
      <div class="faq-list rv">
        {faq.map(([q, a], i) => (
          <details name="faq" open={i === 0}>
            <summary><b>{q}</b><span class="faq-i" aria-hidden="true"></span></summary>
            <p>{a}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  <CtaBand title="Tu carrera en datos" accent="empieza en vivo." />
</BaseLayout>

<script>
  import { PRICE, wa, spec } from "../data/academy";

  // Contador de preventa
  const cd = document.querySelector<HTMLElement>(".cd");
  if (cd) {
    const end = new Date(cd.dataset.deadline!).getTime();
    const p = (n: number) => String(n).padStart(2, "0");
    const u = (k: string) => cd.querySelector<HTMLElement>(`[data-u="${k}"]`)!;
    const tick = () => {
      const s = Math.max(0, Math.floor((end - Date.now()) / 1000));
      u("d").textContent = p(Math.floor(s / 86400));
      u("h").textContent = p(Math.floor((s % 86400) / 3600));
      u("m").textContent = p(Math.floor((s % 3600) / 60));
      u("s").textContent = p(s % 60);
    };
    tick();
    setInterval(tick, 1000);
  }

  // Sub-nav visible tras el hero
  const sub = document.querySelector<HTMLElement>(".subnav")!;
  new IntersectionObserver(([e]) => sub.classList.toggle("show", !e.isIntersecting && e.boundingClientRect.top < 0)).observe(document.querySelector(".da-hero-light")!);

  // Armador de ruta → mensaje de WhatsApp
  const mods = [...document.querySelectorAll<HTMLElement>(".mod[data-name]")];
  const list = document.querySelector<HTMLElement>(".pick-list")!;
  const total = document.querySelector<HTMLElement>(".pick-total")!;
  const send = document.querySelector<HTMLAnchorElement>(".pick-send")!;
  const render = () => {
    const sel = mods.filter((m) => m.classList.contains("sel")).map((m) => m.dataset.name!);
    const all = sel.length === mods.length;
    const sum = all ? PRICE.spec : sel.length * PRICE.course;
    list.innerHTML = "";
    if (!sel.length) list.innerHTML = '<li class="muted">Aún no eliges cursos</li>';
    sel.forEach((n) => { const li = document.createElement("li"); li.textContent = n; list.append(li); });
    if (all) { const li = document.createElement("li"); li.className = "inc"; li.textContent = "+ Proyecto integrador y workshop"; list.append(li); }
    total.hidden = !sel.length;
    total.querySelector("b")!.textContent = `S/ ${sum}`;
    send.href = wa(all ? `Hola, quiero la ${spec.name} completa (S/ ${sum})` : sel.length ? `Hola, quiero inscribirme en: ${sel.join(", ")} (S/ ${sum})` : "Hola, quiero armar mi ruta de cursos");
    mods.forEach((m) => { const b = m.querySelector<HTMLButtonElement>(".add")!; const on = m.classList.contains("sel"); b.textContent = on ? "✓ Agregado" : "Agregar curso"; b.setAttribute("aria-pressed", String(on)); });
  };
  mods.forEach((m) => m.querySelector(".add")!.addEventListener("click", () => { m.classList.toggle("sel"); render(); }));
  document.querySelector(".pick-all")!.addEventListener("click", () => { mods.forEach((m) => m.classList.add("sel")); render(); });
</script>

<style>
  .grow { flex: 1; min-width: 0; }
  .muted { color: var(--text-muted); }
  .wide { width: 100%; }
  .pg-hero { padding-top: 48px; padding-bottom: 64px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); gap: 48px; align-items: center; }
  .trust { margin-top: 22px; display: flex; flex-wrap: wrap; gap: 8px 20px; font-size: 13px; color: var(--text-muted); }
  .trust span:first-child { color: var(--text-main); font-weight: 700; }

  .offer { max-width: 420px; justify-self: end; width: 100%; border-radius: 22px; overflow: hidden; background: #fff; border: 1px solid var(--border-color); box-shadow: 0 40px 80px -40px rgba(6, 14, 42, .45); }
  .offer-top { padding: 20px 22px; color: #fff; background: radial-gradient(300px 200px at 100% 0%, rgba(30, 82, 192, .7), transparent 60%), var(--navy); }
  .offer-row { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(255, 255, 255, .65); }
  .offer-body .offer-row { color: var(--text-muted); }
  .tag-live { padding: 2px 8px; border-radius: 999px; background: rgba(93, 216, 232, .15); color: #5DD8E8; }
  .cd { margin-top: 12px; display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; }
  .cd div { padding: 10px 0; border-radius: 10px; text-align: center; background: rgba(255, 255, 255, .06); border: 1px solid rgba(255, 255, 255, .1); }
  .cd b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 24px; font-variant-numeric: tabular-nums; }
  .cd span { font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: rgba(255, 255, 255, .55); }
  .offer-top p { margin: 12px 0 0; font-size: 12px; color: rgba(255, 255, 255, .6); }
  .offer-body { padding: 20px 22px 18px; }
  .offer-body em { font-style: normal; padding: 2px 8px; border-radius: 999px; background: #E3F7FB; color: var(--accent-color); letter-spacing: 0; }
  .big { margin-top: 6px; font-family: var(--font-display); font-weight: 800; font-size: 36px; letter-spacing: -.02em; }
  .big s { font-family: 'Inter', sans-serif; font-size: 15px; font-weight: 500; color: var(--text-muted); }
  .offer-body p { margin: 4px 0 14px; font-size: 13px; color: var(--text-muted); }
  .limited { margin-top: 10px; display: flex; justify-content: center; align-items: center; gap: 8px; font-size: 12px; font-weight: 600; color: var(--primary-color); }

  .subnav { position: sticky; top: 64px; z-index: 30; background: rgba(255, 255, 255, .95); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px); border-bottom: 1px solid var(--border-color); box-shadow: 0 10px 30px -20px rgba(6, 14, 42, .3); transform: translateY(-110%); opacity: 0; pointer-events: none; transition: transform .4s var(--ease), opacity .3s; margin-bottom: -57px; }
  .subnav.show { transform: none; opacity: 1; pointer-events: auto; }
  .subnav .da-wrap { min-height: 56px; display: flex; align-items: center; gap: 22px; overflow-x: auto; scrollbar-width: none; }
  .subnav b { white-space: nowrap; }
  .links { display: flex; gap: 18px; font-size: 13px; }
  .links a { color: var(--text-muted); white-space: nowrap; }
  .links a:hover { color: var(--text-main); }
  .sub-price { margin-left: auto; font-size: 13px; color: var(--text-muted); white-space: nowrap; }
  .sub-price b { color: var(--text-main); }
  .sub-cta { padding: 9px 16px; border-radius: 999px; background: #1E52C0; color: #fff; font-size: 13px; font-weight: 700; white-space: nowrap; }
  .sub-cta:hover { background: var(--navy); color: #fff; }

  .route { padding: 32px; border-radius: 24px; background: #fff; border: 1px solid var(--border-color); box-shadow: 0 30px 60px -40px rgba(6, 14, 42, .3); }
  .route-head { display: flex; flex-wrap: wrap; gap: 24px; justify-content: space-between; align-items: flex-end; }
  .route .da-h2 { font-size: clamp(1.7rem, 3vw, 2.2rem); }
  .route-stats { display: flex; gap: 28px; }
  .route-stats b { display: block; font-family: var(--font-display); font-weight: 800; font-size: 30px; }
  .route-stats span { font-size: 12px; color: var(--text-muted); }
  .track { list-style: none; margin: 36px 0 0; padding: 0; display: grid; grid-template-columns: repeat(7, 1fr); gap: 8px; text-align: center; }
  .track li { position: relative; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .track li::after { content: ""; position: absolute; top: 17px; left: calc(50% + 20px); width: calc(100% - 32px); height: 3px; border-radius: 2px; background: linear-gradient(90deg, var(--accent-color), #1E52C0); transform-origin: left; transform: scaleX(0); transition: transform .8s var(--ease) calc(var(--d, 0s) + .3s); }
  .track li.in::after { transform: scaleX(1); }
  .track li.end::after { display: none; }
  .dot { width: 36px; height: 36px; display: grid; place-items: center; border-radius: 50%; border: 3px solid var(--accent-color); background: #fff; font-size: 11px; font-weight: 800; color: #1E52C0; }
  .first .dot { background: var(--accent-color); color: #fff; }
  .end .dot { background: var(--navy); border-color: var(--navy); color: #5DD8E8; }
  .track b { margin-top: 6px; font-size: 14px; line-height: 1.25; }
  .track small { font-size: 12px; color: var(--text-muted); }

  .companies { border-bottom: 1px solid var(--border-color); }
  .companies .da-wrap { min-height: 88px; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; }
  .companies span { max-width: 240px; font-size: 11px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--text-muted); }
  .companies div { display: flex; flex-wrap: wrap; gap: 8px; }
  .companies b { padding: 8px 14px; border-radius: 12px; border: 1px solid var(--border-color); font-size: 13px; transition: border-color .25s, transform .25s var(--ease); }
