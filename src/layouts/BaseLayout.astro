---
import ChatBot from '../components/ChatBot.astro';
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Data Academy — Aprende Power BI, SQL, Python y más con clases en vivo.' } = Astro.props;
import { WA, courses, spec } from '../data/academy';
const nav = [
  ['/ruta-analista', 'Especialización'],
  ['/cursos', 'Cursos'],
  ['/#portafolio', 'Portafolio'],
  ['/profesores', 'Docentes'],
  ['/calendario', 'Calendario'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <link rel="icon" type="image/png" href="/img/logo/logo_pestana.png">
  <meta charset="UTF-8">
  <script is:inline>document.documentElement.classList.add("js")</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/global.css">
</head>
<body>
  <header id="navbar" class="da-header">
    <div class="da-wrap da-header-in">
      <a href="/" class="da-logo"><span class="da-logo-mark" aria-hidden="true"><img src="/img/logo/logo_pestana.png" alt="" /></span>Data Academy</a>
      <nav class="da-nav" aria-label="Principal">
        {nav.map(([href, label]) => <a href={href} class:list={{ on: path === href }}>{label}</a>)}
      </nav>
      <div class="da-header-cta">
        <a href={WA} target="_blank" rel="noopener" class="da-icon-btn" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
        <a href={WA} target="_blank" rel="noopener" class="da-btn da-btn-sm">Hablar con un asesor</a>
      </div>
    </div>
  </header>

  <slot />

  <footer id="contacto" class="da-footer">
    <div class="da-wrap">
      <div class="da-footer-grid">
        <div>
          <a href="/" class="da-logo"><span class="da-logo-mark" aria-hidden="true"><img src="/img/logo/logo_pestana.png" alt="" /></span>Data Academy</a>
          <p class="da-footer-text">Clases en vivo, proyectos reales y certificación oficial para analistas de datos en Perú y Latam.</p>
          <div class="da-footer-social">
            <a href="https://www.linkedin.com/company/data-academy-latam/" target="_blank" rel="noopener" class="da-icon-btn" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href={WA} target="_blank" rel="noopener" class="da-icon-btn" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
          </div>
        </div>
        <div>
          <h4>Formación</h4>
          <ul><li><a href="/cursos">Catálogo de cursos</a></li><li><a href={spec.href}>{spec.name}</a></li><li><a href="/calendario">Calendario</a></li><li><a href="/profesores">Equipo docente</a></li></ul>
        </div>
        <div>
          <h4>Cursos</h4>
          <ul>{courses.map((c) => <li><a href={c.href}>{c.short}</a></li>)}</ul>
        </div>
        <div>
          <h4>Contacto</h4>
          <ul><li><a href="https://wa.me/51986575257">WhatsApp +51 986 575 257</a></li><li><a href="https://wa.me/51904882577">WhatsApp +51 904 882 577</a></li><li><a href="https://www.linkedin.com/company/data-academy-latam/" target="_blank" rel="noopener">LinkedIn</a></li></ul>
        </div>
      </div>
      <div class="da-footer-bottom"><span>© 2026 Data Academy. Todos los derechos reservados.</span><span>Excel · SQL · Power BI · Python · Power Automate</span></div>
    </div>
  </footer>

  <ChatBot />

  <script is:inline src="/js/script.js"></script>
  <script is:inline>
    // Scroll reveal: .rv aparece al entrar en pantalla (stagger con style="--d:.1s")
    (() => {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".rv").forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
