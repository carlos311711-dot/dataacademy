---
import ChatBot from '../components/ChatBot.astro';
export interface Props {
  title: string;
  description?: string;
}
const { title, description = 'Data Academy — Aprende Power BI, SQL, Python y más con clases en vivo.' } = Astro.props;
import { WA, courses, spec } from '../data/academy';
const nav = [
  ['/ruta-analista', 'Especialización'],
  ['/cursos', 'Cursos'],
  ['/promociones', 'Promociones'],
  ['/#portafolio', 'Portafolio'],
  ['/profesores', 'Docentes'],
  ['/calendario', 'Calendario'],
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <link rel="icon" type="image/png" href="/img/logo/logo_pestana.png">
  <meta charset="UTF-8">
  <!-- Consent Mode v2: todo denegado hasta que el usuario acepte en el aviso de cookies (debe ir ANTES de GTM) -->
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    // Elección guardada como JSON {stats, ads}; sin elección o inválida = todo denegado
    function cookieConsent(c) {
      var a = c.stats ? 'granted' : 'denied', m = c.ads ? 'granted' : 'denied';
      return { analytics_storage: a, ad_storage: m, ad_user_data: m, ad_personalization: m };
    }
    var c = {}; try { c = JSON.parse(localStorage.getItem('cookies')) || {}; } catch (e) {}
    gtag('consent', 'default', cookieConsent(c));
  </script>
  <!-- Google Tag Manager -->
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-MWJJ5VWW');</script>
  <!-- End Google Tag Manager -->
  <script is:inline>document.documentElement.classList.add("js")</script>
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/styles/global.css">
</head>
<body>
  <!-- Google Tag Manager (noscript) -->
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MWJJ5VWW"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <!-- End Google Tag Manager (noscript) -->
  <header id="navbar" class="da-header">
    <div class="da-wrap da-header-in">
      <a href="/" class="da-logo"><span class="da-logo-mark" aria-hidden="true"><img src="/img/logo/logo_pestana.png" alt="" /></span>Data Academy</a>
      <nav class="da-nav" aria-label="Principal">
        {nav.map(([href, label]) => <a href={href} class:list={{ on: path === href }}>{label}</a>)}
      </nav>
      <div class="da-header-cta">
        <a href={WA} target="_blank" rel="noopener" class="da-icon-btn" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
        <a href={WA} target="_blank" rel="noopener" class="da-btn da-btn-sm">Hablar con un asesor</a>
      </div>
    </div>
  </header>

  <slot />

  <footer id="contacto" class="da-footer">
    <div class="da-wrap">
      <div class="da-footer-grid">
        <div>
          <a href="/" class="da-logo"><span class="da-logo-mark" aria-hidden="true"><img src="/img/logo/logo_pestana.png" alt="" /></span>Data Academy</a>
          <p class="da-footer-text">Clases en vivo, proyectos reales y certificación oficial para analistas de datos en Perú y Latam.</p>
          <div class="da-footer-social">
            <a href="https://www.linkedin.com/company/data-academy-latam/" target="_blank" rel="noopener" class="da-icon-btn" aria-label="LinkedIn"><i class="fab fa-linkedin-in"></i></a>
            <a href={WA} target="_blank" rel="noopener" class="da-icon-btn" aria-label="WhatsApp"><i class="fab fa-whatsapp"></i></a>
          </div>
        </div>
        <div>
          <h4>Formación</h4>
          <ul><li><a href="/cursos">Catálogo de cursos</a></li><li><a href={spec.href}>{spec.name}</a></li><li><a href="/promociones">Promociones</a></li><li><a href="/calendario">Calendario</a></li><li><a href="/profesores">Equipo docente</a></li></ul>
        </div>
        <div>
          <h4>Cursos</h4>
          <ul>{courses.map((c) => <li><a href={c.href}>{c.short}</a></li>)}</ul>
        </div>
        <div>
          <h4>Contacto</h4>
          <ul><li><a href="https://wa.me/51986575257">WhatsApp +51 986 575 257</a></li><li><a href="https://wa.me/51904882577">WhatsApp +51 904 882 577</a></li><li><a href="https://www.linkedin.com/company/data-academy-latam/" target="_blank" rel="noopener">LinkedIn</a></li></ul>
        </div>
      </div>
      <div class="da-footer-bottom"><span>© 2026 Data Academy. Todos los derechos reservados. · <a href="/privacidad">Privacidad y cookies</a> · <a href="/aviso-legal">Aviso legal</a></span><span>Excel · SQL · Power BI · Python · Power Automate</span></div>
    </div>
  </footer>

  <ChatBot />

  <div id="cookie-bar" class="cookie-bar" role="region" aria-labelledby="cookie-title" hidden>
    <div class="cookie-head">
      <h2 id="cookie-title">Gestionar el consentimiento de las cookies</h2>
      <button type="button" class="cookie-x" data-cookies="deny" aria-label="Cerrar y denegar cookies"><i class="fas fa-xmark" aria-hidden="true"></i></button>
    </div>
    <p>Para ofrecerte la mejor experiencia usamos tecnologías como las cookies, que almacenan o acceden a información de tu dispositivo. Aceptarlas nos permite medir de forma agregada cómo se navega el sitio para mejorarlo. Si no las aceptas o retiras tu consentimiento, el sitio sigue funcionando igual.</p>
    <fieldset class="cookie-prefs" id="cookie-prefs" hidden>
      <legend class="cookie-sr">Categorías de cookies</legend>
      <label><input type="checkbox" checked disabled /><span><strong>Funcionales</strong> Necesarias para que el sitio funcione, como tu tema y esta elección. Siempre activas.</span></label>
      <label><input type="checkbox" name="stats" /><span><strong>Estadísticas</strong> Google Analytics: páginas visitadas y dispositivo, de forma agregada.</span></label>
      <label><input type="checkbox" name="ads" /><span><strong>Marketing</strong> Medir el resultado de anuncios de Google.</span></label>
    </fieldset>
    <div class="cookie-actions">
      <button type="button" class="da-btn da-btn-sm" data-cookies="all">Aceptar</button>
      <button type="button" class="da-btn da-btn-sm da-btn-ghost" data-cookies="deny">Denegar</button>
      <button type="button" class="da-btn da-btn-sm da-btn-ghost" data-cookies="prefs" aria-controls="cookie-prefs" aria-expanded="false">Ver preferencias</button>
    </div>
    <nav class="cookie-links" aria-label="Políticas">
      <a href="/privacidad#cookies">Política de cookies</a>
      <a href="/privacidad">Política de privacidad</a>
      <a href="/aviso-legal">Aviso legal</a>
    </nav>
  </div>
  <script is:inline>
    (() => {
      const bar = document.getElementById('cookie-bar');
      const prefs = document.getElementById('cookie-prefs');
      const prefsBtn = bar.querySelector('[data-cookies="prefs"]');
      if (localStorage.getItem('cookies')) return;
      bar.hidden = false;
      bar.addEventListener('click', (e) => {
        const act = e.target.closest('[data-cookies]')?.dataset.cookies;
        if (!act) return;
        if (act === 'prefs' && prefs.hidden) { // 1.er clic abre preferencias, el 2.º las guarda
          prefs.hidden = false;
          prefsBtn.textContent = 'Guardar preferencias';
          prefsBtn.setAttribute('aria-expanded', 'true');
          return;
        }
        const c = act === 'all' ? { stats: true, ads: true }
          : act === 'deny' ? {}
          : { stats: prefs.elements.stats.checked, ads: prefs.elements.ads.checked };
        localStorage.setItem('cookies', JSON.stringify(c));
        gtag('consent', 'update', cookieConsent(c));
        bar.hidden = true;
      });
    })();
  </script>
  <style is:global>
    .cookie-bar { position: fixed; left: 24px; bottom: 24px; z-index: 60; width: min(560px, calc(100% - 128px)); /* deja libre el botón del chat (abajo-derecha) */ max-height: calc(100dvh - 48px); overflow-y: auto; padding: 22px 24px 16px; border-radius: 14px; background: var(--card-bg); color: var(--text-main); border: 1px solid var(--border-color); box-shadow: var(--shadow-md), 0 2px 6px rgba(11, 31, 58, .06); font-size: 13.5px; line-height: 1.6; animation: cookie-in .4s var(--ease) both; }
    .cookie-bar[hidden] { display: none; }
    .cookie-head { position: relative; padding: 0 36px; margin-bottom: 12px; }
    .cookie-bar h2 { margin: 0; font-family: var(--font-display); font-size: 16px; font-weight: 800; text-align: center; color: var(--text-main); }
    .cookie-x { position: absolute; right: -8px; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 32px; height: 32px; border: 0; border-radius: 8px; background: none; color: var(--text-main); font-size: 18px; cursor: pointer; }
    .cookie-x:hover { background: var(--bg-light); }
    .cookie-bar p { margin: 0 0 16px; color: var(--text-muted); }
    .cookie-prefs { border: 0; margin: 0 0 16px; padding: 0; display: grid; gap: 8px; }
    .cookie-prefs[hidden] { display: none; }
    .cookie-prefs label { display: flex; gap: 10px; align-items: flex-start; padding: 10px 12px; border: 1px solid var(--border-color); border-radius: 10px; color: var(--text-muted); cursor: pointer; }
    .cookie-prefs input { margin-top: 4px; accent-color: var(--accent-color); flex: none; }
    .cookie-prefs strong { display: block; color: var(--text-main); }
    .cookie-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
    .cookie-actions { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; }
    .cookie-actions .da-btn { width: 100%; padding-inline: 12px; }
    .cookie-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 4px 18px; margin-top: 14px; font-size: 12.5px; }
    .cookie-links a { color: var(--accent-color); text-decoration: underline; text-underline-offset: 2px; }
    html.dark-theme .cookie-bar .da-btn-ghost { background: transparent; color: var(--text-main); }
    @keyframes cookie-in { from { opacity: 0; transform: translateY(16px); } }
    @media (prefers-reduced-motion: reduce) { .cookie-bar { animation: none; } }
    @media (max-width: 640px) { .cookie-bar { left: 12px; right: 12px; bottom: 88px; width: auto; max-height: calc(100dvh - 100px); padding: 18px 16px 14px; } } /* encima del botón del chat */
  </style>

  <script is:inline src="/js/script.js"></script>
  <script is:inline>
    // Scroll reveal: .rv aparece al entrar en pantalla (stagger con style="--d:.1s")
    (() => {
      const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && (e.target.classList.add("in"), io.unobserve(e.target))), { rootMargin: "0px 0px -8% 0px" });
      document.querySelectorAll(".rv").forEach((el) => io.observe(el));
    })();
  </script>
</body>
</html>
